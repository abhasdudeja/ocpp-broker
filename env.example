# OCPP Broker Environment Configuration
# Copy this file to .env and update with your values
# Environment variables override values in config.yaml

# =============================================================================
# BROKER SETTINGS
# =============================================================================
# BROKER_HOST=0.0.0.0
# BROKER_PORT=8765

# =============================================================================
# REST API (served on the broker port)
# =============================================================================
# Required: every /api request needs this key (X-API-Key header or Bearer token).
# Without it the REST API returns 503.
OCPP_BROKER_API_KEY=

# =============================================================================
# MONGODB SETTINGS
# =============================================================================
# Enable MongoDB integration (true/false)
MONGODB_ENABLED=true

# MongoDB connection string
# Examples:
#   - Local: mongodb://localhost:27017
#   - With auth: mongodb://username:password@localhost:27017
#   - Replica set: mongodb://host1:27017,host2:27017,host3:27017/?replicaSet=rs0
#   - Atlas: mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_CONNECTION_STRING=mongodb://localhost:27017

# MongoDB database name
MONGODB_DATABASE_NAME=ocpp_broker

# =============================================================================
# NOT USED BY ocpp-broker-server
# =============================================================================
# LOG_LEVEL is read but never applied: the log level is fixed at INFO.
# OCPP_BROKER_CONFIG only affects ocpp_broker.config.load_config() when called
# without a path; the server takes its file from `-c` or ./config.yaml.

